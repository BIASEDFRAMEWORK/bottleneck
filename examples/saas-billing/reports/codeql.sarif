{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "CodeQL",
          "informationUri": "https://codeql.github.com/",
          "rules": [
            {
              "id": "go/billing-retry-idempotency",
              "name": "Billing retry idempotency review",
              "shortDescription": {
                "text": "Review retry paths that call payment provider charge APIs."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "problem.severity": "recommendation",
                "precision": "high",
                "tags": ["security", "reliability", "BEHAVIOR-003"],
                "bottleneck.refs": ["INTENT-001", "BEHAVIOR-003"]
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "go/billing-retry-idempotency",
          "level": "note",
          "message": {
            "text": "Retry worker uses the invoice idempotency key before invoking the payment provider."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "services/billing/retry_worker.go"
                },
                "region": {
                  "startLine": 87
                }
              }
            }
          ],
          "properties": {
            "security-severity": "2.1",
            "bottleneck.refs": ["BEHAVIOR-003"],
            "tags": ["Subscription Billing Release"]
          }
        }
      ]
    }
  ]
}
